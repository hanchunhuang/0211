# ---- LINE Messaging API（請建立「新的」channel，不要用滿福寶的）----
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 你自己的 LINE userId（U 開頭）。先不填，私訊機器人「/whoami」就會回你的 userId
ADMIN_USER_IDS=

# ---- Claude API ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- 排程（Asia/Taipei）----
TIMEZONE=Asia/Taipei
# 每天幾點整理當天回饋（HH:MM）
DAILY_DIGEST_AT=23:30
# 次日幾點準備推播（HH:MM）
DAILY_ANNOUNCE_AT=09:00
# true = 時間到直接推播到各群組；false = 先私訊管理者預覽，回覆 /approve 才推播
AUTO_PUSH=false
# true：每晚自動讀程式碼分析每個新問題（較耗 AI 額度）
# false（預設）：只歸納，管理者在後台按「分析這個問題」或私訊 /analyze 編號 才分析
AUTO_ANALYZE=false
# false（預設，手動模式）：David 不讀程式碼——不分析、不自動配對 commit；問題由你和夥伴在後台處理、手動標記完成
# true：開啟讀程式碼的功能（分析按鈕、/analyze、每早自動配對 commit；需要各系統的讀取權杖）
CODE_ANALYSIS=false

# ---- 被回饋的系統程式碼（唯讀 clone，用來分析與自動配對 commit）----
# Cloud Run 這類沒有永久磁碟的環境：填 REPO_URL，啟動後會自動 clone 到 REPO_PATH
REPO_URL=
# 一般主機：先在主機上 git clone https://x-token-auth:<唯讀Token>@bitbucket.org/hokiya/line-hokiya-survey.git /srv/line-hokiya-survey
REPO_PATH=/srv/line-hokiya-survey
REPO_BRANCH=master
# 每次分析／配對前自動 git fetch + reset 到遠端分支（這個資料夾只給機器人用，不要在裡面開發）
REPO_AUTO_UPDATE=true
# AI 判斷 commit 解決問題的信心達 high 才自動標記完成（medium 會列為建議讓你確認）
COMMIT_MATCH_MIN_CONFIDENCE=high

# 客服人員的 LINE userId（逗號分隔），逐字稿會標「（客服）」，AI 不會把他們的話當成回饋
STAFF_USER_IDS=

# ---- 管理者通知改走 Telegram（選填，省 LINE 推播額度；可沿用滿福寶的 bot 或另開一個）----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 網頁後台 https://你的網域/admin（沒設密碼＝後台關閉；請務必走 HTTPS）----
# 對外網址，例如 https://feedback.hokiya.com（登入 cookie 與表單來源檢查會用到）
PUBLIC_BASE_URL=
ADMIN_WEB_PASSWORD=

# ---- 資料庫 ----
# sqlite：資料存在 DATA_DIR/feedback.db（一般主機）
# firestore：存在 Firebase 的 Firestore（Cloud Run 部署用，見 DEPLOY-FIREBASE.md）
DB_BACKEND=sqlite
FIREBASE_PROJECT_ID=
# Firestore 集合名稱前綴，避免和同專案的其他資料混在一起
FIRESTORE_PREFIX=fbot_
# 有填就把截圖存到 Firebase Storage，例如 my-project.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# ---- 排程 ----
# true：程式內建排程（一般主機）；false：由 Cloud Scheduler 呼叫 /tasks/*（Cloud Run）
ENABLE_SCHEDULER=true
# Cloud Scheduler 呼叫 /tasks/* 時帶的密鑰（標頭 X-Task-Token）
TASK_TOKEN=

# ---- 其他 ----
DATA_DIR=./data
# 選填：補充說明（程式庫裡的 CLAUDE.md、docs/handover/AI_ONBOARDING.md 會自動讀取，這裡只放額外的）
SYSTEM_CONTEXT_FILE=./system_context.md
# 每個群組每天最多送幾張截圖給 AI 判讀
MAX_IMAGES_PER_GROUP=20
