# ---- LINE Messaging API（LINE Developers Console > Messaging API channel）----
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 你自己的 LINE userId（U 開頭）。先不填，私訊機器人「/whoami」就會回你的 userId
ADMIN_USER_IDS=

# ---- Claude API ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- 排程（Asia/Taipei）----
TIMEZONE=Asia/Taipei
# 每天幾點整理當天回饋（HH:MM）
DAILY_DIGEST_AT=23:30
# 次日幾點準備推播（HH:MM）
DAILY_ANNOUNCE_AT=09:00
# true = 時間到直接推播到各群組；false = 先私訊管理者預覽，回覆 /approve 才推播
AUTO_PUSH=false

# ---- 其他 ----
DATA_DIR=./data
REPORTS_DIR=./reports
# 選填：你系統的模組/功能說明檔，讓 AI 分析修改方向時更準
SYSTEM_CONTEXT_FILE=./system_context.md
# 每個群組每天最多送幾張截圖給 AI 判讀
MAX_IMAGES_PER_GROUP=20
